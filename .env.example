# Copia este archivo a .env y completalo. .env esta en .gitignore: nunca lo versiones.
# Ver README, seccion "Modo sombra", y docs/adr/0007-modo-sombra-y-testnet.md.

# Obligatoria: donde la sombra persiste sus snapshots.
SHADOW_DATA_DIR=

# Opcionales (los valores por defecto son los del ADR 0007).
# SHADOW_SYMBOL=BTCUSDT
# SHADOW_ORDER_SIZES_USDT=10,100,1000
# SHADOW_SNAPSHOT_MINUTES=15
# SHADOW_DEPTH_LIMIT=1000
# SHADOW_HEARTBEAT_MAX_AGE_MINUTES=45
# SHADOW_MARKET_DATA_URL=https://data-api.binance.vision

# Alertas por Telegram. Van las dos o ninguna. El token es un secreto.
SHADOW_TELEGRAM_TOKEN=
SHADOW_TELEGRAM_CHAT_ID=
