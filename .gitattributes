# Los datasets versionados se comparan por SHA256 contra su manifest. Una
# conversion de fin de linea (core.autocrlf en Windows) cambiaria los bytes y
# el manifest dejaria de verificar: se tratan como binarios.
datasets/** -text -diff
# Las respuestas grabadas de Binance tambien se verifican por SHA256.
tests/live/respuestas/** -text
# Los pesos congelados se verifican por SHA256 contra su manifest: sin conversion de fin de linea.
frozen/** -text
